<?xml version="1.0"?>
<!--
  URDF - Axiom Rover "Mulo"
  Parametri da mulo_specs.md:
    - Telaio: 800x600x300mm
    - Ruote: 20" cargo (r=0.254m), track=0.6m, wheelbase=0.8m
    - Motori: 4x Stepperonline 24V 200W (71.5:1)
    - Massa rover: ~80kg
-->
<robot name="axiom_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =====================================================================
       Materiali
  ====================================================================== -->
  <material name="steel_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="rubber_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="aluminium">
    <color rgba="0.7 0.7 0.75 1.0"/>
  </material>
  <material name="orange_safety">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>

  <!-- =====================================================================
       BASE LINK (telaio principale)
       Massa: 80kg, dimensioni: 800x600x300mm
  ====================================================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.6 0.3"/>
      </geometry>
      <material name="steel_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.8 0.6 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="80.0"/>
      <!-- Inertia telaio rettangolare: I = m/12 * (a²+b²) -->
      <inertia
        ixx="2.5"   ixy="0.0" ixz="0.0"
        iyy="4.5"   iyz="0.0"
        izz="6.0"/>
    </inertial>
  </link>

  <!-- =====================================================================
       FOOTPRINT (link virtuale a terra per Nav2)
  ====================================================================== -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.254" rpy="0 0 0"/>
  </joint>

  <!-- =====================================================================
       SNODO CENTRALE (UCP204 - torsione tra modulo ant/post)
  ====================================================================== -->
  <link name="pivot_link">
    <visual>
      <geometry><cylinder length="0.06" radius="0.02"/></geometry>
      <material name="aluminium"/>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="pivot_joint" type="revolute">
    <parent link="base_link"/>
    <child link="pivot_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.35" upper="0.35" effort="500" velocity="0.5"/>
    <dynamics damping="10.0" friction="5.0"/>
  </joint>

  <!-- =====================================================================
       MACRO RUOTA
       Parametri: nome, x, y (posizione), segno_y (±1)
  ====================================================================== -->

  <!-- Ruota Front Left (FL) -->
  <link name="wheel_fl_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.07" radius="0.254"/></geometry>
      <material name="rubber_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.07" radius="0.254"/></geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <!-- Inertia cilindro: Ixx=Iyy=m/12*(3r²+h²), Izz=m/2*r² -->
      <inertia
        ixx="0.130" ixy="0.0" ixz="0.0"
        iyy="0.130" iyz="0.0"
        izz="0.129"/>
    </inertial>
  </link>
  <joint name="wheel_fl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl_link"/>
    <origin xyz="0.35 0.335 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.5"/>
  </joint>

  <!-- Ruota Front Right (FR) -->
  <link name="wheel_fr_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.07" radius="0.254"/></geometry>
      <material name="rubber_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.07" radius="0.254"/></geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <inertia
        ixx="0.130" ixy="0.0" ixz="0.0"
        iyy="0.130" iyz="0.0"
        izz="0.129"/>
    </inertial>
  </link>
  <joint name="wheel_fr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr_link"/>
    <origin xyz="0.35 -0.335 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.5"/>
  </joint>

  <!-- Ruota Rear Left (RL) -->
  <link name="wheel_rl_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.07" radius="0.254"/></geometry>
      <material name="rubber_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.07" radius="0.254"/></geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <inertia
        ixx="0.130" ixy="0.0" ixz="0.0"
        iyy="0.130" iyz="0.0"
        izz="0.129"/>
    </inertial>
  </link>
  <joint name="wheel_rl_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl_link"/>
    <origin xyz="-0.35 0.335 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.5"/>
  </joint>

  <!-- Ruota Rear Right (RR) -->
  <link name="wheel_rr_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.07" radius="0.254"/></geometry>
      <material name="rubber_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.07" radius="0.254"/></geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <inertia
        ixx="0.130" ixy="0.0" ixz="0.0"
        iyy="0.130" iyz="0.0"
        izz="0.129"/>
    </inertial>
  </link>
  <joint name="wheel_rr_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr_link"/>
    <origin xyz="-0.35 -0.335 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.5"/>
  </joint>

  <!-- =====================================================================
       VERRICELLO (tamburo)
  ====================================================================== -->
  <link name="winch_drum_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder length="0.2" radius="0.05"/></geometry>
      <material name="aluminium"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder length="0.2" radius="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
  </link>
  <joint name="winch_joint" type="continuous">
    <parent link="base_link"/>
    <child link="winch_drum_link"/>
    <!-- Posizionato in avanti e in alto (altezza 0.35m da suolo) -->
    <origin xyz="0.38 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="5.0" friction="2.0"/>
  </joint>

  <!-- =====================================================================
       IMU (Jetson Orin integrata / esterna)
  ====================================================================== -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.04 0.04 0.01"/></geometry>
      <material name="aluminium"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.31" rpy="0 0 0"/>
  </joint>

  <!-- =====================================================================
       DEPTH CAMERA (Intel RealSense D435i)
  ====================================================================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.09 0.025 0.025"/></geometry>
      <material name="steel_dark"/>
    </visual>
    <inertial>
      <mass value="0.072"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Montata in avanti, inclinata verso il basso di 15° -->
    <origin xyz="0.42 0 0.32" rpy="0 0.26 0"/>
  </joint>

  <!-- Frame ottico camera (convenzione ROS: z avanti, x destra, y basso) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- =====================================================================
       GAZEBO PLUGINS
  ====================================================================== -->

  <!-- Skid Steer Drive (4WD) -->
  <gazebo>
    <plugin name="skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>0.67</wheel_separation>
      <wheel_diameter>0.508</wheel_diameter>
      <max_wheel_torque>33.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- IMU plugin -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Depth Camera plugin (RealSense D435i) -->
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.1</near><far>10.0</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
      </camera>
      <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=camera/rgb/image_raw</remapping>
          <remapping>~/depth/image_raw:=camera/depth/image_raw</remapping>
          <remapping>~/points:=camera/depth/points</remapping>
          <remapping>~/camera_info:=camera/rgb/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Attrito ruote su terreno (Gazebo) -->
  <gazebo reference="wheel_fl_link">
    <mu1>0.8</mu1><mu2>0.8</mu2><kp>1e6</kp><kd>1.0</kd>
  </gazebo>
  <gazebo reference="wheel_fr_link">
    <mu1>0.8</mu1><mu2>0.8</mu2><kp>1e6</kp><kd>1.0</kd>
  </gazebo>
  <gazebo reference="wheel_rl_link">
    <mu1>0.8</mu1><mu2>0.8</mu2><kp>1e6</kp><kd>1.0</kd>
  </gazebo>
  <gazebo reference="wheel_rr_link">
    <mu1>0.8</mu1><mu2>0.8</mu2><kp>1e6</kp><kd>1.0</kd>
  </gazebo>

</robot>
